# ============================================================
# PaperThought — Environment Configuration
# Copy this file to backend/.env and fill in your values
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/paperthought

# JWT Secret (change this in production!)
JWT_SECRET=change-this-secret-in-production

# ============================================================
# AI Provider — OpenRouter (NVIDIA Nemotron FREE)
# Get your free API key at: https://openrouter.ai/keys
# 1. Sign up / login at https://openrouter.ai
# 2. Go to Keys → Create Key
# 3. Model used: nvidia/nemotron-3-super-120b-a12b:free (gratis!)
# ============================================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Optional: override the model (default below is free NVIDIA Nemotron)
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# File Storage
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760
